        class CharacterManager {
            constructor() {
                this.clamp = (val, min, max) => Math.max(min, Math.min(max, val));
                const initSharedStats = (affection = {}, antipathy = {}) => ({
                    _hunger: 0, _stomach: 0, _fatigue: 0, affection: affection, antipathy: antipathy
                });

                this.jihye = {
                    id: "jihye", name: "하지혜", info: "고등학교 1학년, 여자", preferredLocation: ["집"],
                    _health: 100, _mental: 100, _normalcy: 100,
                    ...initSharedStats({ sayu: 20, gitaek: 50, dabin: 5 }, { sayu: 0, gitaek: 5, dabin: 30 })
                };

                this.npcs = [
                    { id: "sayu", name: "사유", relation: "동성친구", traits: ["호사가적"], preferredLocations: ["편의점"], mobility: "normal", isActive: () => true, ...initSharedStats({ jihye: 40, gitaek: 10, dabin: 10 }, {}) },
                    { id: "gitaek", name: "기택", relation: "이성", traits: ["모범적", "짝사랑 대상", "지혜를 안 좋아함"], preferredLocations: ["지하철역"], mobility: "low_encounter", isActive: () => true, ...initSharedStats({ jihye: 0, sayu: 2, dabin: 40 }, { jihye: 30, sayu: 5, dabin: 0 }) },
                    { id: "dabin", name: "다빈", relation: "동성", traits: ["일탈적", "기택의 짝사랑 대상"], preferredLocations: ["공터"], mobility: "normal", isActive: () => true, ...initSharedStats({ jihye: 10, sayu: 10, gitaek: 0 }, { jihye: 10, sayu: 10, gitaek: 50 }) },
                    { id: "mina", name: "미나", relation: "지킴이", traits: ["태그"], preferredLocations: ["헬스장"], mobility: "patrol_all", isActive: (j) => j._health <= 40, ...initSharedStats({ jihye: 50 }, {}) },
                    { id: "yusang", name: "유상", relation: "건달", traits: ["태그"], preferredLocations: ["폐건물", "편의점"], mobility: "normal", isActive: (j) => j._mental <= 40, ...initSharedStats({ jihye: 30 }, { jihye: 30 }) },
                    { id: "alice", name: "앨리스", relation: "이상현상", traits: ["태그"], preferredLocations: ["천체관측소"], mobility: "patrol_slow", isActive: (j) => j._normalcy <= 50, ...initSharedStats({ jihye: 60 }, { jihye: 0 }) },
                    { id: "shinwoo", name: "신우", relation: "이성", traits: ["지혜를 짝사랑"], preferredLocations: ["학교"], mobility: "patrol_all", isActive: (j, d) => {
                        if (d.year > 2) return true;
                        if (d.year === 2 && d.month > 3) return true;
                        if (d.year === 2 && d.month === 3 && d.day >= 1) return true;
                        return false;
                    }, ...initSharedStats({ jihye: 50, sayu: 20, gitaek: 0, dabin: 30 }, { jihye: 0, sayu: 10, gitaek: 40, dabin: 0 }) }
                ];
            }
            getCharacter(id) { return id === "jihye" ? this.jihye : this.npcs.find(n => n.id === id); }
            getActiveNPCs(currentDateState) { return this.npcs.filter(npc => npc.isActive(this.jihye, currentDateState)); }
            modifyJihyeStat(statName, amount) {
                let maxVal = 100, minVal = statName === "_normalcy" ? -100 : -10;
                this.jihye[statName] = this.clamp(this.jihye[statName] + amount, minVal, maxVal);
            }
            modifyVital(charId, statName, amount) {
                let char = this.getCharacter(charId);
                if (char) char[statName] = this.clamp(char[statName] + amount, 0, 100);
            }
            modifyRelationship(fromId, type, toId, amount) {
                let char = this.getCharacter(fromId);
                if (!char) return;
                char[type][toId] = this.clamp((char[type][toId] || 0) + amount, type === "affection" ? -10 : 0, 100);
            }
            getRelationship(fromId, type, toId) {
                let char = this.getCharacter(fromId);
                return char && char[type][toId] ? char[type][toId] : 0;
            }
        }

        class TurnEngine {
            constructor(calendarSys, characterSys, placeSys) {
                this.calendar = calendarSys;
                this.chars = characterSys;
                this.places = placeSys;
            }
            findLocationWithTag(tag) {
                let possiblePlaces = [];
                for (const [key, loc] of Object.entries(this.places.locations)) {
                    if (!loc.isReachable) continue;
                    let hasTag = loc.items.some(item => item.tags.includes(tag) && !item.isHidden);
                    if (hasTag) possiblePlaces.push(loc.name);
                }
                if (possiblePlaces.length === 0) return tag === "수면" ? "길거리" : "편의점";
                return possiblePlaces[Math.floor(Math.random() * possiblePlaces.length)];
            }
            getSortedDesires(char, timeState) {
                let desires = [];
                const isWeekday = !["토", "일"].includes(timeState.dow);
                const hour = parseInt(timeState.timeStr.split(':')[0]);
                
                desires.push({ name: "수업", score: (isWeekday && hour >= 9 && hour < 16) ? 50 : 0, target: null });
                desires.push({ name: "식욕", score: Math.pow(char._hunger / 10, 2), target: null });
                desires.push({ name: "요의", score: Math.pow(char._stomach / 10, 2), target: null });
                desires.push({ name: "수면욕", score: Math.pow(char._fatigue / 10, 2), target: null });

                let maxAff = 0, targetLover = null;
                for (const [t, v] of Object.entries(char.affection)) if (v > maxAff) { maxAff = v; targetLover = t; }
                let maxAnti = 0, targetEnemy = null;
                for (const [t, v] of Object.entries(char.antipathy)) if (v > maxAnti) { maxAnti = v; targetEnemy = t; }

                desires.push({ name: "애욕", score: maxAff * 0.4, target: targetLover });
                desires.push({ name: "증오", score: maxAnti * 0.4, target: targetEnemy });
                return desires.sort((a, b) => b.score - a.score);
            }
            pickAction(pool) { return pool[Math.floor(Math.random() * pool.length)]; }
            
            processOneHour() {
                this.calendar.addMinutes(60);
                const timeState = this.calendar.getCurrentState();
                const activeChars = [this.chars.jihye, ...this.chars.getActiveNPCs(timeState)];
                
                let turnLogs = [];
                // 시간 구분선 (구분을 위해 클래스 별도 부여)
                turnLogs.push({ type: "time", text: `=== [${timeState.year}년차 ${timeState.month}월 ${timeState.day}일 ${timeState.dow}요일 ${timeState.timeStr}] ===` });
                let intents = {};

                activeChars.forEach(char => {
                    this.chars.modifyVital(char.id, '_hunger', 5);
                    this.chars.modifyVital(char.id, '_fatigue', 5);

                    let sorted = this.getSortedDesires(char, timeState);
                    let primary = sorted[0];
                    let secondary = sorted[1];

                    if (primary.name === "애욕" && primary.target) {
                        if (this.chars.getRelationship(char.id, 'antipathy', primary.target) >= 31) primary.name = "증오";
                    }

                    let dest = "길거리";
                    if (primary.name === "수업") dest = "학교";
                    else if (primary.name === "식욕") dest = this.findLocationWithTag("음식");
                    else if (primary.name === "요의") dest = "화장실";
                    else if (primary.name === "수면욕") dest = this.findLocationWithTag("수면");

                    intents[char.id] = { char, primary, secondary, dest };
                });

                activeChars.forEach(char => {
                    let intent = intents[char.id].primary;
                    if ((intent.name === "애욕" || intent.name === "증오") && intent.target && intents[intent.target]) {
                        intents[char.id].dest = intents[intent.target].dest; 
                    }
                    char.currentLocation = intents[char.id].dest; 
                });

                let locGroups = {};
                activeChars.forEach(char => {
                    let loc = char.currentLocation;
                    if (!locGroups[loc]) locGroups[loc] = [];
                    locGroups[loc].push(intents[char.id]);
                });

                for (const [loc, occupants] of Object.entries(locGroups)) {
                    let names = occupants.map(o => o.char.name).join(", ");
                    if (occupants.some(o => o.char.id === "jihye")) {
                        turnLogs.push({ type: "log", text: `📍 [${loc}] 에 지혜가 도착했다. (현재 인원: ${names})` });
                    } else if (occupants.length > 1) {
                        turnLogs.push({ type: "log", text: `📍 [${loc}] 에서 ${names}이(가) 마주쳤다.` });
                    }

                    occupants.forEach(occ => {
                        let { char, primary, secondary } = occ;

                        if (primary.name === "수업" && secondary.name === "애욕" && secondary.target) {
                            let targetIntent = intents[secondary.target];
                            let log = `[${char.name}] 은(는) 수업 중 [${this.chars.getCharacter(secondary.target).name}] 을(를) 곁눈질했다.`;
                            
                            if (targetIntent && targetIntent.secondary.name === "애욕" && targetIntent.secondary.target && targetIntent.secondary.target !== char.id) {
                                let rivalId = targetIntent.secondary.target;
                                let rivalName = this.chars.getCharacter(rivalId).name;
                                log += ` 하지만 시선의 끝엔 [${rivalName}] 이(가) 있었다!`;
                                this.chars.modifyRelationship(char.id, 'antipathy', rivalId, 1);
                                if (char.id === "jihye") {
                                    this.chars.modifyJihyeStat('_mental', -3);
                                    log += ` (지혜 멘탈 -3, ${rivalName} 반감 +1)`;
                                }
                            }
                            turnLogs.push({ type: "log", text: log });
                        }

                        if (primary.name === "애욕" && primary.target) {
                            let aff = this.chars.getRelationship(char.id, 'affection', primary.target);
                            let targetName = this.chars.getCharacter(primary.target).name;
                            let action = aff <= 20 ? this.pickAction(["곁눈질", "눈인사"]) : aff <= 50 ? this.pickAction(["살가운 인사", "호감표현", "대화시도"]) : this.pickAction(["고백", "대놓고 쳐다보기", "스킨십 시도", "미행"]);

                            turnLogs.push({ type: "log", text: `💞 [${char.name}] 은(는) [${targetName}] 에게 '${action}' 을(를) 시도했다.` });

                            let targetOcc = occupants.find(o => o.char.id === primary.target);
                            if (targetOcc) {
                                let tId = targetOcc.char.id;
                                let reactScore = this.chars.getRelationship(tId, 'affection', char.id) - this.chars.getRelationship(tId, 'antipathy', char.id);
                                if (reactScore > 0) {
                                    let inc = Math.min(reactScore, 5);
                                    this.chars.modifyRelationship(tId, 'affection', char.id, inc);
                                    turnLogs.push({ type: "log", text: `   -> [${targetName}] 도 미소를 보였다. (애정 +${inc})` });
                                } else if (reactScore < 0) {
                                    let inc = Math.min(Math.abs(reactScore), 5);
                                    this.chars.modifyRelationship(tId, 'antipathy', char.id, inc);
                                    turnLogs.push({ type: "log", text: `   -> [${targetName}] 은(는) 불쾌해했다. (반감 +${inc})` });
                                } else {
                                    turnLogs.push({ type: "log", text: `   -> [${targetName}] 은(는) 별다른 반응이 없었다.` });
                                }
                            }
                        }

                        if (primary.name === "증오" && primary.target) {
                            let anti = this.chars.getRelationship(char.id, 'antipathy', primary.target);
                            let targetName = this.chars.getCharacter(primary.target).name;
                            let action = anti <= 50 ? this.pickAction(["비난", "회피", "거절"]) : this.pickAction(["뺨때리기", "침뱉기"]);
                            turnLogs.push({ type: "log", text: `💢 [${char.name}] 은(는) [${targetName}] 에게 '${action}' 을(를) 했다!` });
                        }

                        if (primary.name === "식욕") { char._hunger = 0; if(char.id === "jihye") turnLogs.push({ type: "log", text: `🍔 지혜는 허기를 채웠다.` }); }
                        if (primary.name === "요의") { char._stomach = 0; if(char.id === "jihye") turnLogs.push({ type: "log", text: `🚽 지혜는 화장실을 다녀왔다.` }); }
                        if (primary.name === "수면욕") { char._fatigue = 0; if(char.id === "jihye") turnLogs.push({ type: "log", text: `💤 지혜는 잠을 잤다.` }); }
                    });
                }
                return turnLogs;
            }
        }

        // ==========================================
        // 2. DOM 요소 연결 및 초기화
        // ==========================================
        const screen1 = document.getElementById('screen1');
        const screen2 = document.getElementById('screen2');
        const overlay = document.getElementById('overlay');
        const startBtn = document.getElementById('start-btn');
        const gearBtn = document.getElementById('gear-btn');
        const homeBtn = document.getElementById('home-btn');
        const animImg = document.getElementById('anim-img');
        const bottomBox = document.getElementById('bottom-box');

        // 엔진 인스턴스 생성
        const calendarSys = new GameCalendar();
        const placeSys = new PlaceManager();
        const characterSys = new CharacterManager();
        const gameEngine = new TurnEngine(calendarSys, characterSys, placeSys);

        // 상단 애니메이션
        const frame1 = "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='64' height='64'><rect width='64' height='64' fill='%23e74c3c'/></svg>";
        const frame2 = "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='64' height='64'><rect width='64' height='64' fill='%233498db'/></svg>";
        animImg.src = frame1;
        let isFrame1 = true;
        setInterval(() => { animImg.src = (isFrame1 = !isFrame1) ? frame1 : frame2; }, 500);

        // 버튼 이벤트
        startBtn.addEventListener('click', () => {
            screen1.classList.remove('active');
            screen2.classList.add('active');
            
            // 시작 시 텍스트 박스 초기화
            bottomBox.innerHTML = '<div class="log-item">SYSTEM: 로그 시스템 가동... 화면(아래 박스)을 터치하여 시간을 진행하세요.</div>';
        });

        gearBtn.addEventListener('click', () => overlay.classList.add('active'));
        homeBtn.addEventListener('click', () => {
            overlay.classList.remove('active');
            screen2.classList.remove('active');
            screen1.classList.add('active');
        });

        // ==========================================
        // 3. 핵심! 터치(클릭) 시 턴 진행
        // ==========================================
        bottomBox.addEventListener('click', () => {
            const logs = gameEngine.processOneHour();
            
            logs.forEach(logObj => {
                const logDiv = document.createElement('div');
                // 시간 제목 부분은 스타일을 다르게 줍니다.
                logDiv.className = logObj.type === 'time' ? 'log-item log-time' : 'log-item';
                logDiv.innerText = logObj.text;
                bottomBox.appendChild(logDiv);
            });

            // 로그가 추가되면 맨 아래로 부드럽게 스크롤
            bottomBox.scrollTo({
                top: bottomBox.scrollHeight,
                behavior: 'smooth'
            });
        });

    </script>
</body>
