        class GameCalendar {
            constructor() {
                this.DAYS_IN_MONTH = [0, 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
                this.currentDayIndex = 1; 
                this.hour = 8;
                this.minute = 0;
                this.events = {}; 
                for (let y = 1; y <= 3; y++) this.generateYearlyEvents(y);
            }
            getDayIndex(year, month, day) {
                let days = (year - 1) * 365;
                for (let i = 1; i < month; i++) days += this.DAYS_IN_MONTH[i];
                days += day;
                return Math.min(days, 365 * 3); 
            }
            getDateFromIndex(index) {
                let year = Math.floor((index - 1) / 365) + 1;
                let remainder = (index - 1) % 365 + 1;
                let month = 1;
                while (remainder > this.DAYS_IN_MONTH[month]) {
                    remainder -= this.DAYS_IN_MONTH[month];
                    month++;
                }
                return { year, month, day: remainder };
            }
            getDOW(index) { return index % 7; }
            getDOWString(index) { return ["일", "월", "화", "수", "목", "금", "토"][this.getDOW(index)]; }
            getSeasonAndSunTimes(month) {
                if (month >= 3 && month <= 5) return { season: "봄", sunrise: {h: 6, m: 0}, sunset: {h: 20, m: 0} }; 
                if (month >= 6 && month <= 8) return { season: "여름", sunrise: {h: 4, m: 30}, sunset: {h: 21, m: 0} }; 
                if (month >= 9 && month <= 10) return { season: "가을", sunrise: {h: 6, m: 0}, sunset: {h: 19, m: 30} }; 
                return { season: "겨울", sunrise: {h: 7, m: 30}, sunset: {h: 18, m: 0} }; 
            }
            getTimeZone(month, hour, minute) {
                const { sunrise, sunset } = this.getSeasonAndSunTimes(month);
                const nowMins = hour * 60 + minute;
                const sunriseMins = sunrise.h * 60 + sunrise.m;
                const sunsetMins = sunset.h * 60 + sunset.m;
                const noonMins = 12 * 60;
                if (nowMins >= sunriseMins && nowMins < noonMins) return "오전";
                if (nowMins >= noonMins && nowMins < sunsetMins) return "오후";
                return "밤";
            }
            addEvent(index, eventName) {
                if (!this.events[index]) this.events[index] = [];
                this.events[index].push(eventName);
            }
            getAdjustedFixedDate(y, m, d) {
                let idx = this.getDayIndex(y, m, d);
                let dow = this.getDOW(idx);
                if (dow === 6) idx += 2; 
                if (dow === 0) idx += 1; 
                return idx;
            }
            getNthWeekday(y, m, n, targetDow) {
                let startIdx = this.getDayIndex(y, m, 1);
                let startDow = this.getDOW(startIdx);
                let offset = (targetDow - startDow + 7) % 7;
                return startIdx + offset + (n - 1) * 7;
            }
            getLastWeekday(y, m, targetDow) {
                let lastDay = this.DAYS_IN_MONTH[m];
                let endIdx = this.getDayIndex(y, m, lastDay);
                let endDow = this.getDOW(endIdx);
                let offset = (endDow - targetDow + 7) % 7;
                return endIdx - offset;
            }
            generateYearlyEvents(y) {
                this.addEvent(this.getAdjustedFixedDate(y, 3, 2), y === 1 ? "신입학" : "개학");
                let aprLastMon = this.getLastWeekday(y, 4, 1);
                for(let i=0; i<5; i++) this.addEvent(aprLastMon + i, "중간고사");
                this.addEvent(this.getNthWeekday(y, 5, 3, 3), "운동회");
                let junLastMon = this.getLastWeekday(y, 6, 1);
                for(let i=0; i<5; i++) this.addEvent(junLastMon + i, "기말고사");
                this.addEvent(this.getNthWeekday(y, 7, 2, 5), "여름방학 시작");
                this.addEvent(this.getAdjustedFixedDate(y, 9, 1), "개학");
                this.addEvent(this.getAdjustedFixedDate(y, 9, 2), "개교기념일");
                this.addEvent(this.getAdjustedFixedDate(y, 10, 8), "교내 글짓기 대회");
                let octSecondMon = this.getNthWeekday(y, 10, 2, 1);
                for(let i=0; i<5; i++) this.addEvent(octSecondMon + i, "중간고사");
                this.addEvent(this.getLastWeekday(y, 10, 3), "학교 축제");
                let novSecondMon = this.getNthWeekday(y, 11, 2, 1);
                for(let i=0; i<5; i++) this.addEvent(novSecondMon + i, "기말고사");
                this.addEvent(this.getNthWeekday(y, 12, 2, 5), "겨울방학 시작");

                if (y === 1) {
                    let maySecondWed = this.getNthWeekday(1, 5, 2, 3);
                    this.addEvent(maySecondWed, "수련회 (1일차)");
                    this.addEvent(maySecondWed + 1, "수련회 (2일차)");
                } else if (y === 2) {
                    let sepThirdWed = this.getNthWeekday(2, 9, 3, 3);
                    this.addEvent(sepThirdWed, "수학여행 (1일차)");
                    this.addEvent(sepThirdWed + 1, "수학여행 (2일차)");
                } else if (y === 3) {
                    let novLastMon = this.getLastWeekday(3, 11, 1);
                    this.addEvent(novLastMon, "졸업여행 (1일차)");
                    this.addEvent(novLastMon + 1, "졸업여행 (2일차)");
                    this.addEvent(novLastMon + 2, "졸업여행 (3일차)");
                }

                const anniversaries = [
                    {m: 2, d: 14, name: "발렌타인 데이"}, {m: 3, d: 14, name: "화이트데이"},
                    {m: 11, d: 11, name: "빼빼로데이"}, {m: 12, d: 25, name: "크리스마스"},
                    {m: 5, d: 5, name: "지혜 생일"}, {m: 10, d: 17, name: "사유 생일"},
                    {m: 2, d: 28, name: "기택 생일"}
                ];
                anniversaries.forEach(ann => {
                    let idx = this.getDayIndex(y, ann.m, ann.d);
                    this.addEvent(idx, ann.name);
                });
            }
            getCurrentState() {
                const { year, month, day } = this.getDateFromIndex(this.currentDayIndex);
                const dow = this.getDOWString(this.currentDayIndex);
                const { season } = this.getSeasonAndSunTimes(month);
                const timeZone = this.getTimeZone(month, this.hour, this.minute);
                return {
                    year, month, day, dow, season, timeZone,
                    timeStr: `${this.hour.toString().padStart(2, '0')}:${this.minute.toString().padStart(2, '0')}`,
                    events: this.events[this.currentDayIndex] || []
                };
            }
            nextDay() {
                if (this.currentDayIndex < 365 * 3) {
                    this.currentDayIndex++;
                    return true;
                }
                return false;
            }
            addMinutes(mins) {
                this.minute += mins;
                while (this.minute >= 60) { this.minute -= 60; this.hour++; }
                while (this.hour >= 24) { this.hour -= 24; this.nextDay(); }
            }
        }

